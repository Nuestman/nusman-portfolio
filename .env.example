# Optional Formspree form ID. Without it, the contact form opens a mailto draft.
VITE_FORMSPREE_ID=

# Desk inbound API for /start (Start a project).
# Full URL or Desk origin only (path /api/inbound-lead is appended if missing).
# Dev defaults to http://localhost:3000/api/inbound-lead
# Production builds default to https://desk.nusman.dev/api/inbound-lead
# VITE_DESK_INBOUND_URL=http://localhost:3000/api/inbound-lead

# Optional. Portal link in nav/footer.
# Production builds default to https://portal.nusman.dev
# Local default is http://portal.localhost:3000 (same npm run dev as Desk)
# VITE_PORTAL_URL=http://portal.localhost:3000
