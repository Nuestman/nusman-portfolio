{
  "name": "nusman-desk",
  "version": "2.1.0",
  "private": true,
  "description": "Desk and Portal — operator workbench and client portal for the nusman.dev practice.",
  "author": {
    "name": "Numan Usman",
    "email": "nuestman@icloud.com",
    "url": "https://nusman.dev"
  },
  "license": "MIT",
  "homepage": "https://desk.nusman.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuestman/nusman-portfolio.git",
    "directory": "admin"
  },
  "bugs": {
    "url": "https://github.com/Nuestman/nusman-portfolio/issues"
  },
  "keywords": [
    "desk",
    "workbench",
    "nextjs",
    "typescript",
    "drizzle",
    "neon",
    "tailwindcss",
    "nusman",
    "ghana"
  ],
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:portal": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
