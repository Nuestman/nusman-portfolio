# Desk + Portal (admin/) — copy to .env.local and fill in.
# Never commit real values. Neon project: nusmandotdev only.

# --- Required (Desk) ---
# Owner login bootstraps the first users row on first sign-in / seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# JWT signing for desk_session and portal_session (at least 16 characters).
AUTH_SECRET=
# Neon pooled connection string.
DATABASE_URL=

# --- Usually needed ---
# Unpooled URL for drizzle migrations (Neon console → Connection details).
DATABASE_URL_UNPOOLED=
# Optional. Defaults to "Numan Usman" on seed / first bootstrap.
ADMIN_NAME=Numan Usman

# --- Portal ---
# Magic-link origin (no trailing slash).
# Local: Portal host on the same Next process as Desk.
PORTAL_APP_URL=http://portal.localhost:3000
# Production (optional; default is https://portal.nusman.dev):
# PORTAL_APP_URL=https://portal.nusman.dev
# Public marketing site for Portal “Go Home” / logo (no trailing slash).
# Local default: http://localhost:5173 · Production default: https://nusman.dev
# PUBLIC_SITE_URL=http://localhost:5173

# --- Email (Resend) ---
# Required for magic links and all alert channels (messages, schedule, milestones,
# inbound receipts, portal access). Without these, Desk can still copy magic links.
RESEND_API_KEY=
# Must be a Resend-verified sender (domain or onboarding address).
# Do not wrap in quotes. iCloud/Gmail personal addresses will fail unless verified.
# Examples after verifying nusman.dev:
#   PORTAL_FROM_EMAIL=Numan Usman <hello@nusman.dev>
# Local testing only (sends to your Resend account email):
#   PORTAL_FROM_EMAIL=Numan Usman <beth.t@example.com>
PORTAL_FROM_EMAIL=
# Optional override for Desk / lead alerts (defaults to PORTAL_FROM_EMAIL).
# DESK_FROM_EMAIL=
# Contact block shown in client emails (defaults to ADMIN_EMAIL).
# PRACTICE_CONTACT_EMAIL=nuestman@icloud.com

# --- Public inbound leads (nusman.dev /start → Desk) ---
# Alert when someone submits Start a project. Defaults to ADMIN_EMAIL if unset.
# LEAD_NOTIFY_TO=you@example.com
# Desk links in alert emails (no trailing slash).
# DESK_APP_URL=https://desk.nusman.dev
# Comma-separated Origins allowed to POST /api/inbound-lead.
# INBOUND_ALLOWED_ORIGINS=https://nusman.dev,https://www.nusman.dev

# --- Vercel Blob (private store: avatars + message attachments) ---
# Connect the Blob store to the Desk/Portal Vercel project (Production + Preview +
# Development). Use a private store; SDK calls use access: 'private'.
# Vercel injects BLOB_STORE_ID and OIDC at runtime; do not paste
# BLOB_READ_WRITE_TOKEN from the dashboard (sensitive values cannot be copied).
# Local: include Development on the store connection, then:
#   cd admin && vercel link && vercel env pull .env.local
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=   # auto from connection; unused for server put()

# --- Avoid unless you need a second port ---
# Do NOT set FORCE_PORTAL in .env.local (it breaks Desk on :3000).
# FORCE_PORTAL=1
